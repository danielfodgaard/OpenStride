# The agent: your Claude API key (https://platform.claude.com/)
ANTHROPIC_API_KEY=

# The provider that holds your activities: intervals.icu
# Both are under Settings, Developer Settings on intervals.icu. The athlete id looks like i123456.
INTERVALS_ICU_API_KEY=
INTERVALS_ICU_ATHLETE_ID=

# Optional: where it runs and what it stores
OPENSTRIDE_HOST=127.0.0.1
OPENSTRIDE_PORT=8000
OPENSTRIDE_DATA_DIR=
OPENSTRIDE_PASSWORD=
# Listening beyond localhost needs a password, or this set to 1 to accept the risk
OPENSTRIDE_ALLOW_OPEN=
# The OS sandbox around the agents' shells: auto (the strongest form the machine can run), on, weak or off
OPENSTRIDE_SANDBOX=auto
# In Docker "today" is UTC unless you set your time zone: uncomment and change
# TZ=Europe/Copenhagen
# Models, check-ins, quiet hours and the monthly budget are not here: they are in data/workspace/settings.yaml,
# and you change them by asking your coach.
