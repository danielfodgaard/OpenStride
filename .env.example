ANTHROPIC_API_KEY=
PLAN_MODEL=claude-sonnet-5-5
ADAPT_MODEL=claude-sonnet-5-5
REVIEW_MODEL=claude-haiku-5-5
PROGRESS_MODEL=claude-sonnet-5-5
CHAT_MODEL=claude-sonnet-5-5
# Optional: where it runs and what it stores
OPENSTRIDE_HOST=127.0.0.1
OPENSTRIDE_PORT=8000
OPENSTRIDE_DATA_DIR=
OPENSTRIDE_PASSWORD=
# Listening beyond localhost needs a password, or this set to 1 to accept the risk
OPENSTRIDE_ALLOW_OPEN=
# off, personal_api or unofficial; GARMIN_SYNC_MINUTES 0 means manual only
GARMIN_MODE=off
GARMIN_SYNC_MINUTES=0
